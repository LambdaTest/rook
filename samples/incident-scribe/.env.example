# Copy to .env and fill in. .env is gitignored. See README.md → Setup.

# The secret every CLI command must pass as --token. Change it if you like.
SCRIBE_API_TOKEN=scribe-local-token

# Your model. Any Anthropic-compatible API works, e.g. GLM through Z.AI:
BASE_URL=https://api.z.ai/api/anthropic
LLM_API_KEY=
LLM_MODEL=

# A different kind of API? Also set LLM_PROVIDER: gemini, openai (Chat Completions) or responses.
# LLM_PROVIDER=

# Copy to .env and fill in. .env is gitignored. See README.md → Configuration.

# Any secret string you choose; every CLI command must pass it as --token.
SCRIBE_API_TOKEN=

# One model provider. The LambdaTest gateway (OpenAI-compatible chat completions,
# HTTP Basic auth). GATEWAY_URL is the base host only: the desk calls
# <GATEWAY_URL>/v1/chat/completions and checks <GATEWAY_URL>/healthz.
LLM_PROVIDER=lambdatest
GATEWAY_URL=https://rook-samples.lambdatest.com
LT_USERNAME=
LT_ACCESS_KEY=
LT_MODEL=auto

# Or GLM through Z.AI's Anthropic-compatible endpoint (comment out the block above first):
# LLM_PROVIDER=glm
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
# GLM_API_KEY=
# GLM_MODEL=

# Or Gemini:
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=

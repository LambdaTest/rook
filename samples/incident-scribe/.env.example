# Copy to .env and fill in. .env is gitignored. See README.md → Configuration.

# Any secret string you choose; every CLI command must pass it as --token.
SCRIBE_API_TOKEN=

# One model provider. GLM through Z.AI's Anthropic-compatible endpoint, for example:
LLM_PROVIDER=glm
ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
GLM_API_KEY=
GLM_MODEL=

# Or Gemini:
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=
